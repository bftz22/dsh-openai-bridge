# ============================================================
# dsh-openai-bridge 配置模板
# 复制本文件为 .env（与 server.mjs 同目录），按需修改后重启桥。
# 注意：.env 包含 API 密钥，已被 .gitignore 排除，切勿提交到仓库。
# ============================================================

# DeepSeek API 密钥（必填；platform.deepseek.com → API Keys 创建）
DEEPSEEK_API_KEY=sk-你的密钥

# 监听端口（默认 8787）
# DSH_BRIDGE_PORT=8787

# 模型名（默认 deepseek-v4-flash）
# DSH_BRIDGE_MODEL=deepseek-v4-flash

# 模型提供方（默认 deepseek-official，一般无需修改）
# DSH_BRIDGE_PROVIDER=deepseek-official

# 会话模式：persistent=长驻会话（默认，跨请求保留上下文）
#            per-request=每个请求新会话（无上下文）
# DSH_BRIDGE_SESSION_MODE=persistent

# 工具过程展示：默认开（🔧 工具调用会实时显示在回复里）；设 0 关闭
# DSH_BRIDGE_SHOW_TOOLS=1

# 调试日志：设 1 时输出每条会话事件（排查问题时开启）
# DSH_BRIDGE_DEBUG=0

# 推理过程透传：设 1 时把 dsh 的 reasoning-delta 事件转为 OpenAI SSE 的
# delta.reasoning_content（非标准字段，DeepSeek 官方 API 同款命名，
# Chatbox 等客户端默认不显示，仅保留数据以便未来兼容）
# DSH_BRIDGE_SHOW_REASONING=0

# 会话存档治理：.sessions/ 目录只保留最新 N 个会话存档（按修改时间），
# 启动时 / /clear /new 时 / 每小时自动清理超出部分
# DSH_BRIDGE_SESSION_DIR=./.sessions
# DSH_BRIDGE_MAX_SESSIONS=20

# 是否采纳请求携带的 system 消息作为 persona：
# Chatbox 工作模式每次都会发一大段动态系统提示词，默认忽略（0）。
# 只有普通客户端且确实需要请求级 persona 时才设 1。
# DSH_BRIDGE_USE_SYSTEM_PROMPT=0

# Agent 系统提示词（persona）；留空使用 dsh 默认 "You are a coding agent."
# DSH_SYSTEM_PROMPT=你是一个乐于助人的编程助手

# Agent 工作目录（bash/pwsh 与文件工具的根目录；默认 = 桥的启动目录）
# DSH_CWD=C:\Users\you\projects\my-project

# ---- 高级：dsh 运行时启动方式（源码仓库方式默认如下，一般无需修改）----
# DSH_RUNTIME_COMMAND=node
# DSH_RUNTIME_ARGS=./packages/examples/jsonrpc-demo/lib/bin.js ./cordis.yml

# 单个回合最大 token 数（不设置则用 dsh 默认）
# DSH_BRIDGE_MAX_TOKENS=49152
